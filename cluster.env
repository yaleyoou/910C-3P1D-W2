# 业务网 IPv4，参与实验的节点配置相同；留空 P2 或 P3 可直接按 2P1D / 1P1D 运行。
P1=CHANGE_P1
P2=CHANGE_P2
P3=CHANGE_P3
D=CHANGE_D
# auto 在每台机器上按该角色的业务 IP 查找本机网卡，也可填四台通用的网卡名。
IFACE=auto
# 填宿主机权重目录（含 config.json 和权重分片），四台可使用同一绝对路径。
MODEL_DIR=/home/caofei/GLM-5.2-w4a8
# 若某台权重位置不同，在四台共用的这份配置中取消对应行的注释。
# MODEL_DIR_P1=/other/models/GLM-5.2-w4a8c8
# MODEL_DIR_P2=/other/models/GLM-5.2-w4a8c8
# MODEL_DIR_P3=/other/models/GLM-5.2-w4a8c8
# MODEL_DIR_D=/other/models/GLM-5.2-w4a8c8
# P1 自动控制其他三台时，SSH 可单独走管理网或 ~/.ssh/config 中的别名。
# SSH_P2=user@p2-management
# SSH_P3=user@p3-management
# SSH_D=user@d-management
# 若节点使用独立 Docker 守护进程 socket，取消下一行注释。
# DOCKER_HOST=unix:///run/glm52-vllm-docker.sock
IMAGE=sha256:b3c4ed45ab4433bda7a306fdaabdd33481d32df9fd41b54dc0c6066602c34fc6
P_STORE=64
# P / D 节点 DP Attention 并行数（1/2/4；TP 自动为 16/DP，EP 保持 16；cases.tsv 第 3 列为每 DP 的 sparse GiB）。
P_DP=1
D_DP=1
# D 节点单 DP 引擎的 --max-num-seqs（cudagraph_capture_sizes 自动对齐至该上限，默认 16）。
D_MAX_NUM_SEQS=16

