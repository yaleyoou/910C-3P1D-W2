+
+TEST_F(HybmVmmBasedSegmentTest, OffloadTp16Allows256GiBReservation)
+{
+    MemSegmentOptions opts;
+    opts.segType = HYBM_MST_DRAM;
+    opts.maxSize = 256ULL * GB;
+    opts.rankCnt = 16;
+    opts.size = 0;
+    opts.scene = HYBM_SCENE_OFFLOAD;
+    opts.enable56BitsGva = false;
+    HybmVmmBasedSegment seg(opts, 0);
+    EXPECT_EQ(seg.ValidateOptions(), BM_OK);
+}
+
+TEST_F(HybmVmmBasedSegmentTest, OffloadTp16RejectsReservationBeyondWindow)
+{
+    MemSegmentOptions opts;
+    opts.segType = HYBM_MST_DRAM;
+    opts.maxSize = 257ULL * GB;
+    opts.rankCnt = 16;
+    opts.size = 0;
+    opts.scene = HYBM_SCENE_OFFLOAD;
+    opts.enable56BitsGva = false;
+    HybmVmmBasedSegment seg(opts, 0);
+    EXPECT_EQ(seg.ValidateOptions(), BM_INVALID_PARAM);
+}
